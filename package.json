{
	"name": "handlink-sos",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start-server.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:seed": "node scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"locations:expire": "node scripts/expire-locations.mjs",
		"android:prepare": "node scripts/prepare-android.mjs",
		"android:doctor": "node scripts/android-doctor.mjs",
		"android:open": "cap open android",
		"test:mobile-config": "node --test tests/mobile-config.test.mjs",
		"admin:create": "node scripts/create-admin.mjs",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"test:db": "node --test tests/database.test.mjs",
		"test:api": "playwright test --config=playwright.database.config.ts",
		"test:frontend": "playwright test --config=playwright.frontend.config.ts",
		"test:trusted": "playwright test --config=playwright.trusted.config.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.2",
		"auth": "^1.6.24",
		"daisyui": "^5.7.48",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/core": "8.5.3",
		"@capacitor/geolocation": "8.2.3",
		"@capacitor/push-notifications": "^8.1.3",
		"@lucide/svelte": "^1.55.0",
		"@zxing/browser": "^0.2.1",
		"better-auth": "^1.6.24",
		"better-sqlite3": "^13.0.2",
		"drizzle-orm": "^0.45.2",
		"firebase-admin": "^14.5.0",
		"nodemailer": "^10.1.1",
		"zod": "^4.6.7"
	}
}
