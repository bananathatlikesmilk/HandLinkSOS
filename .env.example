# Drizzle
DATABASE_URL=local.db

# Public app URL, read at runtime. Use your HTTPS domain when hosted.
ORIGIN="http://localhost:3000"

# Required only by compose.production.yaml; ORIGIN above must be your public HTTPS URL.
CLOUDFLARE_TUNNEL_TOKEN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Optional one-time admin seed on Docker startup. No default credentials.
# Set all three before first startup; remove them after successful seeding.
# Seeded admin email is verified automatically; staff authenticator setup is still required.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# SMTP: 465 uses implicit TLS; other ports must support STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Local AI incident summaries. Install Ollama and pull this model on the server computer.
OLLAMA_SUMMARY_MODEL="qwen2.5:3b"

# Server-only Firebase service account JSON, stored outside this repository.
FIREBASE_SERVICE_ACCOUNT_FILE=""
