# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Optional public URL for Docker; applied at build time and runtime.
DOCKER_ORIGIN="http://localhost:3000"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# SMTP: 465 uses implicit TLS; other ports must support STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Local AI incident summaries. Install Ollama and pull this model on the server computer.
OLLAMA_SUMMARY_MODEL="qwen2.5:3b"
